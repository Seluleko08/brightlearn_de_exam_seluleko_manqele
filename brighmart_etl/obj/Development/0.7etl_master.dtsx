    <DTS:Executable
      DTS:refId="Package\create_vw_brightlearn_sales"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="create_vw_brightlearn_sales"
      DTS:DTSID="{801E22E8-273B-486F-814E-E3DDC2D67087}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_vw_brightlearn_sales"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{3DE1C07C-C2D4-452F-83E8-36D58284ED90}"
          SQLTask:SqlStatementSource="CREATE OR ALTER VIEW .dbo.vw_brightmart_sales&#xA;AS&#xA;&#xA;SELECT&#xA;&#xA;  &#xA;     --Fact Table Keys&#xA;    &#xA;    f.Sales_ID,&#xA;    f.Date_ID,&#xA;    f.Payment_ID,&#xA;    f.Customer_ID,&#xA;    f.Store_ID,&#xA;    f.Product_ID,&#xA;&#xA;      --Date Dimension&#xA;&#xA;    d.Transaction_Date,&#xA;&#xA;  &#xA;      --Customer Dimension&#xA;  &#xA;    c.Customer_first_name,&#xA;    c.Customer_last_name,&#xA;    c.Customer_email,&#xA;    c.Customer_phone,&#xA;    c.Customer_city,&#xA;    c.Customer_province,&#xA;    c.Customer_loyalty_tier,&#xA;    c.Customer_since,&#xA;&#xA;  &#xA;      --Payment Dimension&#xA;&#xA;    p.Payment_Method,&#xA;&#xA;     --Store Dimension&#xA;&#xA;    s.Store_Name,&#xA;    s.Store_city,&#xA;    s.Store_province,&#xA;    s.Store_region,&#xA;    s.Store_manager,&#xA;&#xA;&#xA;     --Product Dimension&#xA;   &#xA;    pr.Product_name,&#xA;    pr.Category,&#xA;    pr.Sub_category,&#xA;    pr.Sku,&#xA;    pr.Supplier,&#xA;&#xA;  &#xA;      --Fact Measures&#xA; &#xA;    f.Transaction_amount,&#xA;    f.Transaction_discount,&#xA;    f.Unit_price,&#xA;    f.Cost_price,&#xA;    f.Qty,&#xA;    f.Line_amount,&#xA;    f.Stock_on_hand,&#xA;    f.Reorder_threshold,&#xA;&#xA;    f.LoadDate&#xA;&#xA;FROM prod_brightmart_dwh.dbo.load_clean_fact_brightmart_sales AS f&#xA;&#xA;INNER JOIN prod_brightmart_dwh.dbo.load_clean_dim_date AS d&#xA;    ON f.Date_ID = d.Date_ID&#xA;&#xA;INNER JOIN prod_brightmart_dwh.dbo.load_clean_dim_customer AS c&#xA;    ON f.Customer_ID = c.Customer_ID&#xA;&#xA;INNER JOIN prod_brightmart_dwh.dbo.load_clean_dim_payment AS p&#xA;    ON f.Payment_ID = p.Payment_ID&#xA;&#xA;INNER JOIN prod_brightmart_dwh.dbo.load_clean_dim_store AS s&#xA;    ON f.Store_ID = s.Store_ID&#xA;&#xA;INNER JOIN prod_brightmart_dwh.dbo.load_clean_dim_product AS pr&#xA;    ON f.Product_ID = pr.Product_ID;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
